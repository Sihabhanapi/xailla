<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="16dp" android:background="#F8F9FA">
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/hint_link"
        app:boxCornerRadiusTopStart="12dp" app:boxCornerRadiusTopEnd="12dp" app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp" app:boxBackgroundColor="#FFFFFF">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLink" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textUri" android:maxLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
    <Button android:id="@+id/btnAdd" android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginTop="12dp" android:text="@string/add_config" android:textColor="#FFFFFF"
        android:backgroundTint="@color/blue_primary" app:cornerRadius="12dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="16dp" />
</LinearLayout>
